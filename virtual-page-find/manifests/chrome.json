{
  "manifest_version": 3,
  "name": "Virtual Page Find",
  "version": "0.2.6",
  "description": "Find visible text across a scrollable or virtualized page.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Virtual Page Find",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
