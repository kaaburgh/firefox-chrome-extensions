{
  "manifest_version": 3,
  "name": "Virtual Page Find",
  "version": "0.2.16",
  "description": "Find visible text across a scrollable or virtualized page.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Virtual Page Find",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "theme_icons": [
      {
        "size": 16,
        "light": "icons/light-16.png",
        "dark": "icons/dark-16.png"
      },
      {
        "size": 32,
        "light": "icons/light-32.png",
        "dark": "icons/dark-32.png"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "virtual-page-find@kaaburgh",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
